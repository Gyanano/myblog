---
import { SITE, NAV } from "../consts";
const path = Astro.url.pathname;
---

<header class:list={["site", { home: path === "/" }]} transition:persist="site-header">
  <a class="logo" href="/" aria-label="首页">{SITE.author}</a>
  <nav aria-label="主导航">
    <ul>
      {NAV.map((n) => (
        <li>
          <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>
            {n.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
