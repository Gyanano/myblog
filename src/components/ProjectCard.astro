---
import Arrow from "./Arrow.astro";
import type { CollectionEntry } from "astro:content";
interface Props {
  project: CollectionEntry<"projects">;
}
const { title, desc, stack, repo, image } = Astro.props.project.data;
---

<li>
  <a class="pr" href={repo} target="_blank" rel="noopener">
    <h3>{title} <Arrow dir="out" /></h3>
    <div class="pr-d">
      <p>{desc}</p>
      {stack?.length ? <div class="stack">{stack.join("  ·  ")}</div> : null}
    </div>
    {image && <img src={image} alt="" loading="lazy" decoding="async" />}
  </a>
</li>
