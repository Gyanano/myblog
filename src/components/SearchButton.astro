---
// 搜索入口：放在文章区内容旁边，不放进全站顶栏，让各页顶栏保持一致。
const { class: cls } = Astro.props;
---

<button class:list={["search-btn", cls]} type="button" data-open-search aria-label="搜索文章">
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
  <span>搜索</span>
  <kbd>⌘K</kbd>
</button>
