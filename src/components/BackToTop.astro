<button id="back-to-top" class="back-to-top" type="button" aria-label="返回顶部" transition:persist="back-to-top">
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
</button>

<script>
  function initBackToTop() {
    const btn = document.getElementById("back-to-top");
    if (!btn) return;
    const sync = () => btn.classList.toggle("is-visible", (window.scrollY || 0) > 320);
    if (!(window as any).__backToTopScroll) {
      (window as any).__backToTopScroll = true;
      window.addEventListener("scroll", sync, { passive: true });
    }
    if (btn.dataset.bound !== "1") {
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        const lenis = (window as any).__lenis;
        if (lenis) lenis.scrollTo(0, { duration: 1.1 });
        else window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
    sync();
  }
  document.addEventListener("astro:page-load", initBackToTop);
</script>
