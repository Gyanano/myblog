---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { SITE } from "../consts";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageTransition from "../components/PageTransition.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  title?: string;
  description?: string;
  docs?: boolean; // 文档式页面：没有光锥
  footer?: boolean; // 工具页占满视口，没有页脚
  lamp?: boolean; // 页顶的静态光锥（首页有自己的舞台，文档页不打扰阅读）
}
const { title, description = SITE.description, docs = false, lamp = !docs, footer = true } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.author}` : SITE.title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#060708" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/hanken.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anybody.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // 绕过浏览器原生 View Transitions 的整页快照：过场由我们自己的水墨遮罩完成，
      // 不需要浏览器为一个用不到的视觉过渡拍新旧两张快照（换页卡顿的真凶，codex 经
      // 读 Astro 运行时源码确认）。必须在 <ClientRouter /> 加载前替换，
      // 这样 Astro 探测 supportsViewTransitions 时拿到的就是这个直通实现。
      // 注：主题切换从不调用 navigate()/startViewTransition，故此改动不影响主题切换。
      (function () {
        if (!document.startViewTransition) return;
        document.startViewTransition = function (updateCallback) {
          var updateCallbackDone = Promise.resolve().then(updateCallback);
          var finished = updateCallbackDone.then(function () {
            return new Promise(function (resolve) {
              requestAnimationFrame(function () {
                requestAnimationFrame(resolve);
              });
            });
          });
          return {
            updateCallbackDone: updateCallbackDone,
            ready: updateCallbackDone,
            finished: finished,
            skipTransition: function () {},
            types: new Set(),
          };
        };
      })();
    </script>
    <script is:inline>
      // js 标记：入场「开灯」只在脚本可用时才隐藏内容。
      document.documentElement.classList.add("js");
      document.addEventListener("astro:after-swap", function () { document.documentElement.classList.add("js"); });
      // 首页首次进入（本会话）才显示加载进度；减少动效时跳过。
      try {
        if (location.pathname === "/" && !sessionStorage.getItem("pl") && !matchMedia("(prefers-reduced-motion: reduce)").matches)
          document.documentElement.classList.add("pl-on");
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <slot name="top" />
    {lamp && <div class="lamp" aria-hidden="true"><i class="cone"></i></div>}
    <Nav />
    <main>
      <slot />
    </main>
    {footer && <Footer />}
    <PageTransition />
    <BackToTop />

    <script>
      // 平滑滚动：与 gsap.ticker 同步；减少动效时不启用。
      // 动态加载：依赖加载失败时只少平滑滚动，入场和顶栏不受影响
      let lenis: any = null, lenisLoading = false;
      async function initLenis() {
        if (lenis || lenisLoading || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        lenisLoading = true;
        try {
          const [{ default: gsap }, { default: Lenis }] = await Promise.all([import("gsap"), import("lenis")]);
          lenis = new Lenis({ lerp: 0.07, wheelMultiplier: 0.9, smoothWheel: true });
          gsap.ticker.add((time: number) => lenis.raf(time * 1000));
          gsap.ticker.lagSmoothing(0);
          (window as any).__lenis = lenis;
        } catch (err) {
          console.error("[BaseLayout] 平滑滚动加载失败：", err);
        } finally {
          lenisLoading = false;
        }
      }
      let traverse = false;
      document.addEventListener("astro:before-preparation", (e: any) => { traverse = e.navigationType === "traverse"; });
      // 入场：元素进入视口时「开灯」
      let rvIO: IntersectionObserver | null = null;
      function initReveal() {
        rvIO?.disconnect();
        const els = document.querySelectorAll(".rv");
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) { els.forEach((e) => e.classList.add("lit")); return; }
        rvIO = new IntersectionObserver((list) => {
          for (const e of list) if (e.isIntersecting) { e.target.classList.add("lit"); rvIO!.unobserve(e.target); }
        }, { rootMargin: "0px 0px -12% 0px" });
        els.forEach((e) => rvIO!.observe(e));
      }
      // 顶栏：滚动超过 40px 缩成胶囊
      const syncHdr = () => document.documentElement.classList.toggle("hdr-compact", window.scrollY > 40);
      if (!(window as any).__hdrInit) {
        (window as any).__hdrInit = true;
        window.addEventListener("scroll", syncHdr, { passive: true });
      }
      document.addEventListener("astro:after-swap", syncHdr);
      document.addEventListener("astro:page-load", () => {
        syncHdr();
        initLenis();
        initReveal();
        // 前进/后退保留浏览器恢复的滚动位置，只有新导航才回顶
        if (lenis && !traverse) lenis.scrollTo(0, { immediate: true });
        lenis?.resize();
        traverse = false;
      });
    </script>
  </body>
</html>
