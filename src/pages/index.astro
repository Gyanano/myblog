---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroStage from "../components/HeroStage.astro";
import Arrow from "../components/Arrow.astro";
import { getPublishedPosts, getListedPosts } from "../lib/blog";
import WorkCover from "../components/WorkCover.astro";
import { getWorks } from "../lib/portfolio";
import { KEYWORDS, SKILLS } from "../consts";

const [lead, ...rest] = getListedPosts(await getPublishedPosts()).slice(0, 5);
const day = (d: Date) => d.toISOString().slice(0, 10);
// 作品台固定一屏高，最多放 6 件；其余在 /work 查看
const works = (await getWorks()).filter((w) => w.data.home).slice(0, 6);
// 图标均在 public/icons：品牌图标（Simple Icons）+ 通用线性图标（Lucide：RTOS、PCB、示波器）
const ICON: Record<string, string> = {
  React: "react", TypeScript: "typescript", "Node.js": "nodedotjs", Python: "python", Go: "go", Docker: "docker",
  "C/C++": "cplusplus", STM32: "stmicroelectronics", ESP32: "espressif", Git: "git", Linux: "linux",
  Tailwind: "tailwindcss", "Framer Motion": "framer", "Next.js": "nextdotjs", PostgreSQL: "postgresql",
  PlatformIO: "platformio", "VS Code": "visualstudiocode",
  RTOS: "cpu", "PCB Design": "circuit-board", Oscilloscopes: "activity",
};
---

<BaseLayout lamp={false}>
  <div id="preloader" slot="top" aria-hidden="true">
    <div class="pl-num"><span id="pl-num">0</span><i>%</i></div>
    <div class="pl-track"><div id="pl-bar"></div></div>
  </div>

  <section class="hero" id="hero">
    <HeroStage>
      <h1 class="sr">Gyanano</h1>
      <p class="sr">{KEYWORDS.join("、")}</p>
    </HeroStage>
    <noscript><p class="wm-fallback">Gyanano</p></noscript>
  </section>

  <section class="tech rv" aria-label="技术栈">
    {SKILLS.map((g) => (
      <div class="tech-col">
        <h2>{g.group}</h2>
        <ul>
          {g.items.map((it) => (
            <li>
              {ICON[it] && <span class="ic" style={`--i:url(/icons/${ICON[it]}.svg)`}></span>}
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  {works.length > 0 && (
    <section class="works" id="works" aria-labelledby="works-h" style={`--n:${works.length}`}>
      <div class="works-pin">
        <h2 class="sr" id="works-h">作品集</h2>
        <div class="works-body">
          <div class="works-col">
          <ol class="works-list">
            {works.map(({ data: w }, i) => (
              <li class:list={["wk", { on: i === 0 }]}>
                <h3><button type="button" data-i={i}>{w.title}</button></h3>
                <div class="wk-d">
                  <div>
                    <div class="wk-img"><WorkCover title={w.title} cover={w.cover} /></div>
                    <p>{w.summary}</p>
                    {w.tags?.length ? <div class="stack">{w.tags.join("  ·  ")}</div> : null}
                    {w.link && <a class="tlink" href={w.link} target="_blank" rel="noopener">查看作品 <Arrow dir="out" /></a>}
                    {!w.link && w.repo && <a class="tlink" href={w.repo} target="_blank" rel="noopener">查看代码 <Arrow dir="out" /></a>}
                  </div>
                </div>
              </li>
            ))}
          </ol>
          <a class="tlink works-more" href="/work">更多 <Arrow /></a>
          </div>
          <div class="deck" aria-hidden="true">
            <div class="deck-in">
              {works.map(({ data: w }, i) => (
                <div class="sc" style={`--d:${Math.min(i, 3)}`}>
                  <WorkCover title={w.title} cover={w.cover} />
                  <i class="sc-sh"></i>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {lead && (
    <section class="writing rv" aria-labelledby="writing-h">
      <div class="essays">
        <a class="essay-lead" href={`/blog/${lead.id}`}>
          <time>{day(lead.data.date)}</time>
          <h3>{lead.data.title}</h3>
          {lead.data.description && <p>{lead.data.description}</p>}
        </a>
        <div class="essay-col">
          <h2 class="writing-h" id="writing-h">我的随笔</h2>
          <ol class="essay-list">
            {rest.map((p) => (
              <li>
                <a href={`/blog/${p.id}`}>
                  <span>{p.data.title}</span>
                  <time>{day(p.data.date)}</time>
                </a>
              </li>
            ))}
          </ol>
          <a class="tlink writing-more" href="/blog">更多 <Arrow /></a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // 作品台：滚动进度决定当前作品。牌堆的每一帧都由连续值 p 算出，
  // 所以快速滚动、回滚和点击跳转都不会撕裂，回滚时动画自然反向。
  const VIS = 2; // 顶牌之后露出的层数
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const smooth = (q: number) => q * q * (3 - 2 * q);

  let off: (() => void) | null = null;
  function init() {
    off?.();
    const sec = document.getElementById("works");
    if (!sec || !matchMedia("(min-width: 961px)").matches) return;
    const items = [...sec.querySelectorAll<HTMLElement>(".wk")];
    const cards = [...sec.querySelectorAll<HTMLElement>(".sc")];
    const shades = cards.map((c) => c.querySelector<HTMLElement>(".sc-sh")!);
    const n = items.length;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const state = { p: 0 };
    let cur = 0, raf = 0, anim = 0;

    // 牌堆动画不依赖第三方库：连续值 p 走一条缓入缓出曲线，中途改目标时从当前位置继续
    const tween = (to: number, ms: number) => {
      cancelAnimationFrame(anim);
      const from = state.p, t0 = performance.now();
      const tick = (t: number) => {
        const q = Math.min(1, (t - t0) / ms);
        state.p = from + (to - from) * (q < 0.5 ? 4 * q * q * q : 1 - (-2 * q + 2) ** 3 / 2);
        render();
        if (q < 1) anim = requestAnimationFrame(tick);
      };
      anim = requestAnimationFrame(tick);
    };
    const place = (i: number, d: number, lift: number, op: number, z: number) => {
      const vd = Math.min(d, VIS + 1), c = cards[i];
      c.style.transform = `translate(${vd * 8.5}%, ${vd * -9 - lift * 105}%) rotate(${vd * 3.1 - 3 - lift * 7}deg) scale(${1 - vd * 0.045})`;
      c.style.opacity = String(op);
      c.style.zIndex = String(z);
      shades[i].style.opacity = String(Math.min(0.78, vd * 0.3));
    };
    const render = () => {
      const p = state.p;
      for (let i = 0; i < n; i++) {
        const pos = ((i - p) % n + n) % n;
        if (pos <= n - 1) { place(i, pos, 0, clamp(VIS + 1 - pos, 0, 1), 100 - Math.round(pos * 10)); continue; }
        // pos 在 (n-1, n)：这张牌正从顶部离开，再从底部插回
        const u = pos - (n - 1);
        if (u > 0.32) {
          const e = (1 - u) / 0.68; // 上滑离开
          place(i, 0, smooth(e), 1 - smooth(clamp((e - 0.5) / 0.5, 0, 1)), 200);
        } else {
          const r = u / 0.32; // 从牌堆后方插回
          const d = Math.min(n - 1, VIS) + r;
          place(i, d, 0, n - 1 > VIS ? 0 : 1 - r, 1);
        }
      }
    };
    const set = (i: number) => {
      if (i === cur) return;
      const steps = Math.abs(i - cur);
      items[cur].classList.remove("on");
      cur = i;
      items[i].classList.add("on");
      if (reduced) { state.p = i; render(); return; }
      tween(i, 1150 + (steps - 1) * 350);
    };
    const update = () => {
      raf = 0;
      const r = sec.getBoundingClientRect(), run = r.height - innerHeight;
      set(run > 0 ? clamp(Math.floor((-r.top / run) * n), 0, n - 1) : 0);
    };
    const on = () => { if (!raf) raf = requestAnimationFrame(update); };
    const click = (e: Event) => {
      const b = (e.target as HTMLElement).closest?.("button[data-i]") as HTMLElement | null;
      if (!b) return;
      const r = sec.getBoundingClientRect(), run = r.height - innerHeight;
      const y = scrollY + r.top + ((Number(b.dataset.i) + 0.5) / n) * run;
      const l = (window as any).__lenis;
      if (l) l.scrollTo(y, { duration: 0.9 }); else scrollTo({ top: y, behavior: "smooth" });
    };
    addEventListener("scroll", on, { passive: true });
    sec.addEventListener("click", click);
    update();
    state.p = cur;
    render();
    off = () => { cancelAnimationFrame(raf); cancelAnimationFrame(anim); removeEventListener("scroll", on); sec.removeEventListener("click", click); };
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => { off?.(); off = null; });
</script>
