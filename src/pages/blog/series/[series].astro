---
import { getPublishedPosts, getListedPosts, getSeriesMap, navTags, navSeries, type SeriesInfo } from "../../../lib/blog";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import PostIndex from "../../../components/PostIndex.astro";
import Arrow from "../../../components/Arrow.astro";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return [...getSeriesMap(posts).values()].map((s) => ({ params: { series: s.name }, props: { series: s } }));
}

const { series } = Astro.props as { series: SeriesInfo };
const listed = getListedPosts(await getPublishedPosts());
// 未列出的系列：这一页只给已经进来的读者看，侧栏不放公开标签
const hidden = !series.posts.some((p) => listed.includes(p));
const first = series.posts[0];
---

<DocsLayout title={`系列 · ${series.name}`} description={series.description} tags={hidden ? undefined : navTags(listed)} series={navSeries(listed, series)} activeSeries={series.name} index>
  <div class="pi-head">
    <h1>{series.name}</h1>
    <p>{series.description}</p>
    <div class="pi-sum">
      <a class="tlink" href={`/blog/${first.id}`}>从第一篇开始 <Arrow /></a>
      <span>共 {series.count} 篇</span>
    </div>
  </div>
  <PostIndex posts={series.posts} ordered />
</DocsLayout>
