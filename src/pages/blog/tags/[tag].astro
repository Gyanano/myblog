---
import { getPublishedPosts, getListedPosts, navTags, navSeries, isUnlisted } from "../../../lib/blog";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import PostIndex from "../../../components/PostIndex.astro";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tagSet = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tagSet.add(t)));
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: { tag, tagged: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, tagged } = Astro.props as { tag: string; tagged: Awaited<ReturnType<typeof getPublishedPosts>> };
// 公开标签页不露出未列出的文章
const shown = tagged.filter((p) => !isUnlisted(p));
const list = shown.length ? shown : tagged;
const listed = getListedPosts(await getPublishedPosts());
const tags = navTags(listed, shown.length ? tag : undefined);
---

<DocsLayout title={`文章 · #${tag}`} description={`标签「${tag}」下的文章`} tags={tags} series={navSeries(listed)} activeTag={tag} index>
  <h1 class="sr">{tag}</h1>
  <PostIndex posts={list} />
</DocsLayout>
