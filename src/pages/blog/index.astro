---
import { getPublishedPosts, getListedPosts, navTags, navSeries } from "../../lib/blog";
import DocsLayout from "../../layouts/DocsLayout.astro";
import PostIndex from "../../components/PostIndex.astro";
import NineGate from "../../components/NineGate.astro";

const posts = getListedPosts(await getPublishedPosts());
---

<DocsLayout title="文章" description="文章与笔记" tags={navTags(posts)} series={navSeries(posts)} all index>
  <h1 class="sr">文章</h1>
  <PostIndex posts={posts} />
  <NineGate />
</DocsLayout>
