---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Arrow from "../../components/Arrow.astro";
import { tools } from "../../tools/registry";
---

<BaseLayout title="工具" description="日常小工具">
  <h1 class="sr">工具</h1>
  {tools.length === 0 ? (
    <p class="wg-empty">工具整理中。</p>
  ) : (
    <ul class="tl">
      {tools.map((t) => (
        <li>
          <a href={t.external ?? `/tools/${t.id}`} {...(t.external ? { target: "_blank", rel: "noopener" } : {})}>
            <h2>{t.title}</h2>
            <p>{t.description}</p>
            <span class="tl-c">{t.category}</span>
            <Arrow dir={t.external ? "out" : "right"} />
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
